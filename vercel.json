{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/workflows.ts": {
      "maxDuration": 120
    },
    "api/learner.ts": {
      "maxDuration": 300
    },
    "api/knowledge-generation.ts": {
      "maxDuration": 300
    },
    "api/assistant.ts": {
      "maxDuration": 120,
      "regions": [
        "sin1"
      ]
    },
    "api/**/*.ts": {
      "maxDuration": 30
    },
    "api/workflow-compiler.py": {
      "maxDuration": 120,
      "includeFiles": "services/workflow/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/edge-actions",
      "destination": "/api/learner?resource=edge-actions"
    },
    {
      "source": "/api/evidence",
      "destination": "/api/learner?resource=evidence"
    },
    {
      "source": "/api/courses",
      "destination": "/api/course?resource=courses"
    },
    {
      "source": "/api/course-authoring",
      "destination": "/api/course?resource=authoring"
    },
    {
      "source": "/api/learning",
      "destination": "/api/learner?resource=learning"
    },
    {
      "source": "/api/micro",
      "destination": "/api/learner?resource=micro"
    },
    {
      "source": "/api/progress",
      "destination": "/api/learner?resource=progress"
    },
    {
      "source": "/api/navigation",
      "destination": "/api/learner?resource=navigation"
    },
    {
      "source": "/api/workflow-compiler/:path*",
      "destination": "/api/workflow-compiler"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "daemons": {
    "worker": { "root": "services/workflow", "entrypoint": "Dockerfile", "command": ["eduflow-workflow", "worker"], "instances": { "sin1": 1 }, "resources": { "requests": { "memory": "1Gi" } }, "terminationGracePeriodSeconds": 660 },
    "watchdog": { "root": "services/workflow", "entrypoint": "Dockerfile", "command": ["eduflow-workflow", "watchdog"], "instances": { "sin1": 1 }, "resources": { "requests": { "memory": "1Gi" } }, "terminationGracePeriodSeconds": 15 }
  }
}

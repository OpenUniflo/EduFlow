{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["sin1"],
  "functions": { "main.py": { "maxDuration": 120 } },
  "daemons": {
    "worker": { "root": ".", "entrypoint": "Dockerfile", "command": ["eduflow-workflow", "worker"], "instances": { "sin1": 1 }, "resources": { "requests": { "memory": "1Gi" } }, "terminationGracePeriodSeconds": 660 },
    "watchdog": { "root": ".", "entrypoint": "Dockerfile", "command": ["eduflow-workflow", "watchdog"], "instances": { "sin1": 1 }, "resources": { "requests": { "memory": "1Gi" } }, "terminationGracePeriodSeconds": 15 }
  }
}

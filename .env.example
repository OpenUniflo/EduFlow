VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-publishable-key-from-pnpm-db-start
# Optional. Unset = enabled only when VITE_SUPABASE_URL points at localhost
# (Supabase local mail inbox). Set to true only after a hosted mail service exists.
VITE_AUTH_PASSWORD_RESET_ENABLED=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=local-secret-key-from-pnpm-db-start
# Any non-empty OpenAI-compatible provider label is accepted; the base URL and
# model select the actual endpoint. Example shown for opencode-go.
LLM_PROVIDER=opencode
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
EMBEDDING_PROVIDER=dmxapi
EMBEDDING_BASE_URL=https://www.dmxapi.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
LOCAL_ADMIN_EMAIL=local-admin@eduflow.local
LOCAL_ADMIN_PASSWORD=replace-with-local-password
LOCAL_STUDENT_EMAIL=local-student@eduflow.local
LOCAL_STUDENT_PASSWORD=replace-with-local-password
LOCAL_TEACHER_EMAIL=local-teacher@eduflow.local
LOCAL_TEACHER_PASSWORD=replace-with-local-password

      },
      {
        "id": "extract-next-review",
        "from": "extract",
        "to": "review",
        "outlet": "next"
      },
      {
        "id": "review-next-route",
        "from": "review",
        "to": "route",
        "outlet": "next"
      },
      {
        "id": "route-approved-receipt_args",
        "from": "route",
        "to": "receipt_args",

      },
      {
        "id": "receipt_args-next-ack",
        "from": "receipt_args",
        "to": "ack",
        "outlet": "next"
      },
      {
        "id": "ack-next-accepted",
        "from": "ack",
        "to": "accepted",
        "outlet": "next"
      },
      {
        "id": "accepted-next-end",
        "from": "accepted",
        "to": "end",
        "outlet": "next"
      },
      {
        "id": "route-rejected-rejected",
        "from": "route",
        "to": "rejected",
        "outlet": "rejected"
      },
      {
        "id": "rejected-next-end",
        "from": "rejected",
        "to": "end",
        "outlet": "next"
      }
    ],
    "outputBindings": {
      "draft": {
        "source": "state",
        "pointer": "/draft",
        "onMissing": {
          "mode": "error"
        }
      },
      "approved": {

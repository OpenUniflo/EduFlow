          "language": "python",
          "code": "def process(input, context):\n    rows = sorted(input[\"results\"], key=lambda x:x[\"dimension\"])\n    text = \"\\n\".join(\"【\"+x[\"dimension\"]+\"】\"+(\"采用\" if x[\"accepted\"] else \"不采用\")+\"：\"+x[\"draft\"]+\"；审核备注：\"+x[\"comment\"] for x in rows)\n    return {\"report\":text}"
        },

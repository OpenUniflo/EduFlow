                "id": "package",
                "label": "封装已审核意见",
                "type": "core.function",
                "typeVersion": 1,
                "config": {
                  "implementation": "code",
                  "language": "python",
                  "code": "def process(input, context):\n    return {\"results\":[{\"dimension\":input[\"dimension\"],\"draft\":input[\"draft\"],\"accepted\":input[\"accepted\"],\"comment\":input[\"comment\"]}]}"
                },
                "inputs": {
                  "dimension": {
                    "source": "input",
                    "pointer": "/dimension",
                    "onMissing": {
                      "mode": "error"
                    }
                  },
                  "draft": {
                    "source": "state",
                    "pointer": "/draft",
                    "onMissing": {

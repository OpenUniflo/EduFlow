          "language": "python",
          "code": "def process(input, context):\n    if len(set(input[\"dimensions\"])) != len(input[\"dimensions\"]):\n        raise ValueError(\"Review dimensions must be distinct\")\n    return {\"items\":[{\"dimension\":x} for x in input[\"dimensions\"]],\"results\":[]}",

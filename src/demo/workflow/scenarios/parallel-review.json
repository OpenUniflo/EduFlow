              {
                "id": "prompt",
                "label": "构造本维度评审任务",
                "type": "core.function",
                "typeVersion": 1,
                "config": {
                  "implementation": "code",
                  "language": "python",
                  "code": "import uuid\ndef process(input, context):\n    text = \"你负责方案评审的【\" + input[\"dimension\"] + \"】维度。项目：\" + input[\"brief\"] + \"。用中文给出不超过80字的结论，包含一条具体建议；开头写明维度。只使用提供的信息，不编造已发生事实。\"\n    return {\"messages\":[{\"id\":str(uuid.uuid4()),\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":text}]}]}"
                },
                "inputs": {
                  "dimension": {
                    "source": "input",
                    "pointer": "/dimension",
                    "onMissing": {
                      "mode": "error"
                    }
                  },
                  "brief": {
                    "source": "input",
                    "pointer": "/brief",
                    "onMissing": {
                      "mode": "error"
                    }
                  }
                },
                "writes": {
                  "messages": "/messages"
                }
              },
              {
                "id": "analyst",
                "label": "生成本维度评审意见",
                "type": "core.llm",
                "typeVersion": 1,
                "config": {
                  "providerRef": "deepseek",
                  "modelRef": "deepseek-flash",
                  "modelParameters": {
                    "thinking": {
                      "type": "disabled"
                    }
                  },
                  "allowedToolRefs": []
                },
                "inputs": {
                  "messages": {
                    "source": "state",
                    "pointer": "/messages",
                    "onMissing": {
                      "mode": "error"
                    }
                  }
                },
                "writes": {
                  "messages": "/messages"
                }
              },
              {
                "id": "extract",
                "label": "提取本维度结论",
                "type": "core.function",
                "typeVersion": 1,
                "config": {
                  "implementation": "code",
                  "language": "python",
                  "code": "def process(input, context):\n    answers = [m for m in input[\"messages\"] if m[\"role\"] == \"assistant\" and not m.get(\"toolCalls\")]\n    text = \"\".join(c[\"text\"] for c in answers[-1][\"content\"] if c[\"type\"] == \"text\") if answers else \"\"\n    if not text.strip():\n        raise ValueError(\"No complete assistant answer\")\n    return {\"draft\": text}"
                },
                "inputs": {
                  "messages": {
                    "source": "state",
                    "pointer": "/messages",
                    "onMissing": {
                      "mode": "error"
                    }
                  }
                },
                "writes": {
                  "draft": "/draft"
                }
              },
              {
                "id": "review",
                "label": "请审核这一项评审意见",
                "type": "core.transform",
                "typeVersion": 1,
                "config": {
                  "operationRef": "core.identity",
                  "operationVersion": 1,
                  "authoring": {
                    "interrupt": {
                      "title": "请审核这一项评审意见",
                      "schema": {
                        "type": "object",
                        "properties": {
                          "accepted": {
                            "type": "boolean",
                            "title": "是否采用本项建议？"
                          },
                          "comment": {
                            "type": "string",
                            "title": "人工审核备注（可留空）",
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "accepted",
                          "comment"
                        ],
                        "additionalProperties": false
                      },
                      "resumeWrites": {
                        "accepted": "accepted",
                        "comment": "comment"
                      }
                    }
                  }
                },
                "inputs": {
                  "value": {
                    "source": "literal",
                    "value": true
                  }
                },
                "writes": {}
              },

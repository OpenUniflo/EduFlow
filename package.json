{
  "name": "eduflow-prototype",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "@xyflow/react": "^12.10.2",
    "3d-force-graph": "1.79.1",
    "elkjs": "^0.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-3d": "^1.29.1",
    "react-router-dom": "^7.16.0",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
